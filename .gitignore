# Packaging output and logs (tools/package.ps1, zip-check, upload)
dist/
*.log

# The throwaway Sandbox project lives outside the repo; belt and braces
Sandbox/

# OS / tools
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# Claude Code local-only settings and secrets
.claude/settings.local.json
.cache/
node_modules/
meshy_output/
.env
*.secret
butler_creds

# Python bytecode from editor scripts
__pycache__/
*.pyc
