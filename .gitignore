Plugins/**/Intermediate/
# Baked-lighting data: we use Lumen (dynamic), never rely on baked lighting
*_BuiltData.uasset

# Generated IDE / project files (regenerate: UnrealBuildTool -projectfiles)
.vs/
.idea/
.vscode/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
