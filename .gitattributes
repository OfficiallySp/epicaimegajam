# Line endings: store LF, check out per platform; scripts pinned.
* text=auto
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text
*.uproject text
*.uplugin text
*.ini text
*.cpp text
*.h text
*.cs text
*.py text
*.md text
*.json text
*.svg text
*.gltf text
*.usda text

# Git LFS: Unreal binaries and media. Run `git lfs install` on every clone BEFORE adding these.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
