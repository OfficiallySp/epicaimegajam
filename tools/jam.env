# Jam settings read by tools/*.ps1 and tools/*.sh. Environment variables with the same names win.
# Team and game names are reduced to [A-Za-z0-9] for the zip name: TeamName_GameName.zip
JAM_TEAM_NAME=officiallysp
JAM_GAME_NAME=FixItInPost
# itch.io target as user/game-slug (the project page must exist; a draft page is fine)
ITCH_TARGET=
# butler channel for iteration builds (the final submission goes through the web dashboard)
ITCH_CHANNEL=win64-dev
# Engine roots
UE_ROOT_WIN="C:\Users\Shane\Epic Games\UE_5.8"
UE_ROOT_MAC="/Users/Shared/Epic Games/UE_5.8"
